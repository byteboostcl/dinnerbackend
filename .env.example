# Railway inyecta esta variable si conectas el plugin de Postgres a este
# servicio. Si la copias a mano, usa la "Connection URL" del plugin. Si te
# conectas por la URL pública (fuera de la red privada de Railway) y pide SSL,
# agrega "?sslmode=require" al final.
DATABASE_URL=postgresql://usuario:password@host:5432/railway

# Secreto que debe venir en la URL del webhook (?secret=...). Genera uno propio,
# largo y aleatorio — no uses este valor de ejemplo.
WEBHOOK_SECRET=cambia-este-valor-por-uno-largo-y-aleatorio

# API key para consultar /api/leads y /api/leads/export (header x-api-key o ?api_key=).
ADMIN_API_KEY=cambia-este-valor-tambien
