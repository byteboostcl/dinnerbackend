{
  "name": "dinnerbackend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend Next.js: recibe (via webhook de FormSubmit) y expone los registros de todas las sedes (Hermosillo y futuras) como JSON o descarga .xlsx.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "prisma migrate deploy && next start",
    "postinstall": "prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "exceljs": "^4.4.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "6.19.3",
    "typescript": "^5.7.0"
  }
}
