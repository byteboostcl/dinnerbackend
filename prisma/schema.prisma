generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Tabla genérica de registros/leads para TODAS las sedes (Hermosillo hoy;
/// Ensenada, Puebla, CDMX, Tijuana o cualquier sede futura mañana), no solo
/// Hermosillo. `sede` es texto libre a propósito: agregar una sede nueva
/// nunca debe requerir una migración de esquema.
model Lead {
  id     String @id @default(uuid())
  sede   String
  /// Canal de origen, p. ej. "formsubmit-webhook". Permite sumar otros
  /// canales de captura después sin tocar el esquema.
  source String @default("formsubmit-webhook")

  fullName   String?
  email      String?
  phone      String?
  guestCount String?

  /// Campos del formulario que no se pudieron mapear a una columna conocida,
  /// tal cual llegaron.
  extra Json?

  /// Payload completo y sin tocar del webhook — auditoría si algún mapeo
  /// queda mal.
  raw Json

  createdAt DateTime @default(now())

  @@index([sede])
  @@index([email])
  @@map("leads")
}

// ---------------------------------------------------------------------------
// Reservas
//
// Sustituye progresivamente al widget de TuriTop. Las piezas son cuatro:
//
//   Season       una temporada en una ciudad (Hermosillo, marzo 2027)
//   Experience   lo que se vende dentro de esa temporada, con su precio
//                (Cena Atardecer, Cena con Estrellas)
//   Flight       un vuelo concreto: fecha, hora y 22 asientos
//   Booking      la compra, con sus boletos
//
// Esa separación existe porque el precio y el nombre cambian por temporada,
// pero el vuelo es la unidad que se llena y la que el staff abre y cierra.
//
// Sobre el dinero: todos los importes son enteros en centavos. Usar decimales
// para dinero es la forma clásica de perder un peso por redondeo, y Stripe
// trabaja en centavos de todos modos.
//
// Sobre las horas: todo se guarda en UTC. La zona de la temporada
// (`timezone`) es la que manda para mostrar e interpretar, porque Sonora no
// cambia de horario y el resto del país sí.
// ---------------------------------------------------------------------------

/// Quién puede entrar al panel del staff.
///
/// Dos roles bastan hoy: STAFF opera la temporada (abre y cierra vuelos, ve
/// reservas) y ADMIN además administra usuarios. Un rol de solo lectura se
/// agregará cuando alguien lo necesite, no antes.
enum UserRole {
  ADMIN
  STAFF
}

model User {
  id    String   @id @default(uuid())
  email String   @unique
  name  String
  /// scrypt$N$sal$hash (ver lib/password.ts). Nunca la contraseña en claro.
  passwordHash String
  role  UserRole @default(STAFF)

  /// Desactivar en vez de borrar: las acciones pasadas siguen atribuidas a
  /// alguien, y volver a dar acceso es un clic.
  active Boolean @default(true)

  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum SeasonStatus {
  /// Se está armando: no se muestra en el sitio.
  DRAFT
  /// Vendiendo.
  PUBLISHED
  /// Terminó o se detuvo la venta.
  CLOSED
}

enum FlightStatus {
  /// Abierto a la venta mientras queden lugares.
  SCHEDULED
  /// Cerrado a mano por el staff (clima, evento privado, corte de venta).
  CLOSED
  /// Cancelado después de haber vendido: obliga a reubicar o reembolsar.
  CANCELLED
}

enum BookingStatus {
  /// Se generó la intención de pago y el cupo está apartado, pero Stripe aún
  /// no confirma. Si el pago no llega, el apartado vence y los lugares vuelven.
  PENDING
  /// Pago confirmado por webhook. Es el único estado que ocupa lugar de verdad.
  CONFIRMED
  /// Cancelada antes de usarse, con o sin reembolso.
  CANCELLED
  /// Reembolsada total o parcialmente (ver refundedCents).
  REFUNDED
  /// El apartado venció sin pago.
  EXPIRED
}

/// Cómo descuenta un código promocional.
enum PromoKind {
  /// Porcentaje sobre el total, 1 a 100.
  PERCENT
  /// Cantidad fija en centavos.
  FIXED
  /// Boletos gratis por cada N pagados (2x1 y variantes).
  FREE_SEATS
  /// Cortesía total: la reserva queda en cero.
  FULL_COMP
}

/// Código promocional.
///
/// El importe final SIEMPRE se calcula en el servidor a partir de este
/// registro. El navegador nunca manda el descuento: mandarlo sería dejar que
/// cualquiera edite el precio desde la consola.
model PromoCode {
  id String @id @default(uuid())

  /// Siempre en mayúsculas y sin espacios; se normaliza al guardar y al
  /// validar, porque la gente lo teclea como quiere.
  code        String    @unique
  description String?
  kind        PromoKind

  /// Significado según `kind`: porcentaje (PERCENT), centavos (FIXED),
  /// boletos gratis por bloque (FREE_SEATS). En FULL_COMP se ignora.
  value Int

  /// Solo FREE_SEATS: boletos pagados que exige cada boleto gratis.
  /// Un 2x1 es buyRequired 1 y value 1; "compra 3 y llévate 1" es 3 y 1.
  buyRequired Int @default(1)

  /// Límite de canjes en total. null = sin límite.
  maxRedemptions Int?
  timesRedeemed  Int @default(0)

  /// Mínimo de lugares para que aplique.
  minSeats Int @default(1)

  validFrom  DateTime?
  validUntil DateTime?

  /// Restricciones opcionales. Sin ellas, el código vale en todo el sitio.
  seasonId     String?
  experienceId String?

  active Boolean @default(true)

  /// Quién lo creó, para rastrear cortesías: son dinero que no entra.
  createdBy String?

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, validUntil])
  @@map("promo_codes")
}

/// Plantilla de un correo automático, editable desde el panel.
///
/// Se guarda en base y no en el código para que el staff pueda cambiar el
/// texto sin un despliegue — es justo lo que hacían en TuriTop, donde cada
/// temporada tenía su propio cuerpo.
///
/// `seasonId` null es la plantilla general; una con temporada la sobrescribe
/// para esa temporada. Así CDMX puede decir "Campo Marte" y Hermosillo
/// "Parque La Ruina" sin duplicar todo el correo.
model EmailTemplate {
  id String @id @default(uuid())

  /// Qué correo es. Hoy solo 'booking_confirmation'.
  key String

  seasonId String?
  season   Season? @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  subject  String
  bodyHtml String  @db.Text

  active    Boolean @default(true)
  updatedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, seasonId])
  @@map("email_templates")
}

/// Registro de cada correo que sale del sistema.
///
/// Existe por una razón muy concreta de operación: cuando alguien llama
/// diciendo "no me llegó la confirmación", el equipo necesita poder
/// responder si se envió, a qué dirección y si el proveedor lo aceptó, en
/// vez de adivinar. También deja ver de un vistazo si los recordatorios de
/// un vuelo ya salieron, que es lo que evita mandarlos dos veces.
model EmailLog {
  id String @id @default(uuid())

  /// 'booking_confirmation', 'booking_reminder', 'test'.
  kind String

  /// Puede ser null: un envío de prueba no pertenece a ninguna reserva.
  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  toEmail String
  subject String

  /// true si el proveedor aceptó el envío. Aceptado no es lo mismo que
  /// entregado, y por eso se guarda también la respuesta.
  ok    Boolean
  /// Id que devuelve Resend, para rastrear el mensaje en su panel.
  providerId String?
  /// Mensaje de error cuando falló, tal cual llegó.
  error String? @db.Text

  /// Correo del staff cuando el envío fue manual; null si fue automático.
  sentBy String?

  createdAt DateTime @default(now())

  @@index([bookingId])
  @@index([kind, createdAt])
  @@map("email_logs")
}

/// Hasta dónde llega una ciudad en el sitio público.
enum CitySiteStatus {
  /// Tiene página propia en el sitio Angular y la reserva funciona ahí.
  LIVE
  /// Existe para el equipo y ya puede tener temporadas y vuelos, pero el
  /// sitio todavía no la muestra: falta construir su página.
  PENDING
}

/// Sede de Dinner in the Sky.
///
/// Existe para que el equipo pueda crear la temporada de una ciudad nueva sin
/// pedirle nada a nadie, y para que el panel deje de depender de que alguien
/// teclee bien un slug: una letra de más en "ciudad-de-mexico" dejaba la
/// temporada apuntando a una página que no existe, y nada avisaba.
///
/// `siteStatus` NO se edita desde el panel a propósito. Que una ciudad
/// aparezca en el sitio depende de que alguien construya su página en el
/// repositorio Angular (ruta, textos, fotos y el alta en CITIES). Mientras eso
/// no ocurra, crear la temporada aquí no la publica en ningún lado, y el panel
/// tiene que decirlo en vez de dejar creer lo contrario. El cambio a LIVE lo
/// hace quien despliega el sitio, con `scripts/city-live.mjs`.
model City {
  /// Coincide exactamente con el slug de la ruta en el sitio ('hermosillo',
  /// 'ciudad-de-mexico'). Es la llave porque es lo que viaja en la URL.
  slug String @id

  name String

  /// Zona IANA por omisión al crear temporadas de esta ciudad. Sonora no
  /// cambia de horario y el resto del país sí, así que equivocarse aquí
  /// corre todos los vuelos una hora.
  timezone String

  siteStatus CitySiteStatus @default(PENDING)

  /// Orden en el que el equipo quiere verlas listadas.
  position Int @default(0)

  /// Una ciudad que ya no opera se desactiva; nunca se borra, porque sus
  /// temporadas y reservas vendidas siguen existiendo.
  active Boolean @default(true)

  /// Nota del equipo: contacto de la sede, pendientes, lo que haga falta.
  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cities")
}

model Season {
  id String @id @default(uuid())

  /// Coincide con el slug de la ciudad en el sitio Angular ('hermosillo').
  citySlug String
  name     String
  /// Sede física, para el boleto y los correos.
  venueName    String?
  venueAddress String?

  /// IANA, p. ej. 'America/Hermosillo'. Sonora no aplica horario de verano:
  /// asumir la zona de CDMX desfasaría los vuelos una hora media temporada.
  timezone String @default("America/Hermosillo")
  currency String @default("MXN")

  startsOn DateTime @db.Date
  endsOn   DateTime @db.Date

  status SeasonStatus @default(DRAFT)

  experiences    Experience[]
  emailTemplates EmailTemplate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([citySlug, status])
  @@map("seasons")
}

model Experience {
  id       String @id @default(uuid())
  seasonId String
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  /// Estable dentro de la temporada ('cena-atardecer'): es lo que se manda a
  /// GA4 como item_id, así que cambiarlo rompe la continuidad de los informes.
  slug        String
  name        String
  description String?

  /// Precio por persona del ticket base, en centavos, impuestos incluidos.
  ///
  /// Se conserva porque es el precio "desde" que se muestra en el sitio y el
  /// que usan las promociones cuando no se apunta a un ticket concreto. El
  /// precio que se cobra sale de cada TicketType.
  priceCents Int

  /// Orden en que se listan en el sitio.
  position Int @default(0)

  ticketTypes TicketType[]
  flights     Flight[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([seasonId, slug])
  @@map("experiences")
}

/// Lo que se elige dentro de una experiencia.
///
/// Existe porque un mismo vuelo se vende en varias modalidades: menú regular,
/// vegetariano o infantil, y antes adulto y niño con precios distintos. Sin
/// este nivel, el precio cobrado sería siempre el mismo y habría que crear
/// una experiencia por menú, duplicando horarios.
///
/// Los extras (paquete de anillo, botella, pastelito, ramo) viven aquí
/// también, con `occupiesSeat` en false: se cobran pero no ocupan plaza en la
/// mesa de 22.
model TicketType {
  id           String     @id @default(uuid())
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  /// Estable: se manda a GA4 como item_variant.
  slug String
  name String
  /// Aclaración que se muestra bajo el nombre ("De 6 a 12 años").
  note String?

  priceCents Int

  /// false = extra. No consume asiento del vuelo, solo suma al importe.
  occupiesSeat Boolean @default(true)

  /// Límites por reserva. maxPerBooking null = sin tope propio (manda el cupo
  /// del vuelo). El paquete de anillo, por ejemplo, va con 1.
  minPerBooking Int  @default(0)
  maxPerBooking Int?

  /// Se puede retirar de la venta sin borrarlo: las reservas que ya lo
  /// usaron siguen teniendo sentido.
  active   Boolean @default(true)
  position Int     @default(0)

  items BookingItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([experienceId, slug])
  @@map("ticket_types")
}

/// Línea de una reserva: qué tipo de ticket, cuántos y a qué precio.
///
/// El precio se copia aquí al comprar. Si mañana sube la tarifa o se retira
/// un extra, lo que se cobró sigue siendo verificable sin arqueología.
model BookingItem {
  id        String  @id @default(uuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  ticketTypeId String
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id])

  /// Nombre al momento de la compra, por si luego se renombra.
  nameAtPurchase String
  unitPriceCents Int
  quantity       Int
  /// Asientos que consumió esta línea (0 en los extras).
  seats Int

  createdAt DateTime @default(now())

  @@index([bookingId])
  @@map("booking_items")
}

model Flight {
  id           String     @id @default(uuid())
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  /// Instante de despegue, en UTC.
  startsAt DateTime

  /// La mesa son 22 lugares, pero se guarda por vuelo porque un privado o un
  /// bloqueo técnico pueden reducirla.
  capacity Int @default(22)

  /// Lugares comprometidos: confirmados más apartados vigentes.
  ///
  /// Es un contador materializado a propósito, no un COUNT. Toda reserva lo
  /// incrementa con un UPDATE condicional
  /// (`SET seats_taken = seats_taken + n WHERE id = ? AND seats_taken + n <= capacity`),
  /// que en Postgres es atómico: si dos personas pelean por el último lugar,
  /// la segunda afecta cero filas y se queda sin cupo. Contar reservas en el
  /// momento de vender abriría una ventana para sobrevender.
  seatsTaken Int @default(0)

  status FlightStatus @default(SCHEDULED)

  /// Nota interna del staff (motivo de cierre, por ejemplo). No se muestra.
  staffNote String?

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([experienceId, startsAt])
  @@index([startsAt, status])
  @@map("flights")
}

model Booking {
  id String @id @default(uuid())

  /// Código corto que ve el cliente y que se busca en puerta ('DITS-7F3K2A').
  code String @unique

  flightId String
  flight   Flight @relation(fields: [flightId], references: [id])

  seats Int

  /// Datos de contacto de quien compra. Son datos personales: solo se piden
  /// los que hacen falta para entregar el servicio (aviso de privacidad,
  /// finalidades primarias).
  customerName  String
  customerEmail String
  customerPhone String?

  /// Lo que se cobra, ya con el descuento aplicado.
  amountCents Int
  currency    String @default("MXN")

  /// Precio antes del descuento y cuánto se descontó. Se guardan los dos
  /// para poder explicar un cobro meses después sin recalcular nada, y
  /// porque el valor del código puede cambiar o el código desaparecer.
  subtotalCents Int?
  discountCents Int  @default(0)

  promoCodeId String?
  promoCode   PromoCode? @relation(fields: [promoCodeId], references: [id])
  /// El código tal como se usó: si alguien lo renombra o lo borra, la
  /// reserva sigue diciendo con qué se compró.
  promoCodeUsed String?

  status BookingStatus @default(PENDING)

  /// Apartado: hasta cuándo se guardan los lugares sin pago confirmado.
  /// Pasado ese instante, un proceso los libera.
  holdExpiresAt DateTime?

  /// Identificadores de Stripe. `paymentIntentId` es único para que un
  /// reintento de webhook no pueda crear una segunda reserva del mismo pago.
  stripeSessionId       String? @unique
  stripePaymentIntentId String? @unique

  refundedCents Int @default(0)

  /// El cliente pidió factura. Mientras el CFDI no esté automatizado, esto es
  /// lo que le dice al staff a quién hay que facturar.
  invoiceRequested Boolean @default(false)

  /// Por dónde entró la venta ('web', 'staff'), para separar la venta en
  /// línea de la que captura el equipo a mano.
  channel String @default("web")

  /// Lo que el cliente completa DESPUÉS de pagar: elección de menú, alergias
  /// y si celebra algo. Va en JSON y no en columnas porque cada temporada
  /// pregunta cosas distintas, y porque nada de esto puede bloquear la
  /// compra: se pide cuando el dinero ya entró.
  ///
  /// Las alergias son datos de salud. Se guardan solo porque la cocina los
  /// necesita para no enviar un plato que mande a alguien al hospital, y no
  /// se usan para ninguna otra finalidad.
  preferences Json?

  confirmedAt DateTime?
  cancelledAt DateTime?
  /// Por qué se canceló, en palabras del staff. Sin esto, meses después
  /// nadie puede explicar un reembolso.
  cancelReason String?
  /// Quién canceló (correo del staff), para no depender de la memoria.
  cancelledBy String?

  /// Notas del equipo sobre la reserva: cambios por teléfono, acuerdos,
  /// avisos para puerta. No se muestran al cliente ni salen en el correo.
  internalNotes String? @db.Text

  tickets   Ticket[]
  items     BookingItem[]
  emailLogs EmailLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([flightId, status])
  @@index([customerEmail])
  @@index([status, holdExpiresAt])
  @@map("bookings")
}

model Ticket {
  id        String  @id @default(uuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  /// Valor del QR. Es un secreto por boleto, no el id de la reserva: con el
  /// id bastaría adivinar un consecutivo para falsificar un acceso.
  qrToken String @unique

  /// Nombre del pasajero cuando se captura en puerta; puede ir vacío.
  passengerName String?

  checkedInAt DateTime?
  checkedInBy String?

  createdAt DateTime @default(now())

  @@index([bookingId])
  @@map("tickets")
}

/// Registro de eventos de Stripe ya procesados.
///
/// Stripe reintenta los webhooks y puede mandar el mismo evento más de una
/// vez; sin esta tabla, un reintento duplicaría boletos o reembolsos. El id
/// del evento es la clave: si ya está, se responde 200 y no se hace nada.
model StripeEvent {
  id            String   @id
  type          String
  processedAt   DateTime @default(now())
  /// Payload tal cual, para auditar una discrepancia con el panel de Stripe.
  payload       Json

  @@index([type])
  @@map("stripe_events")
}

/// Configuración general de la empresa (fila única, id "default").
///
/// Vive en base de datos y no en variables de entorno para que el staff pueda
/// cambiar contacto, medición y política de cancelación sin un despliegue.
model CompanySettings {
  id                 String   @id @default("default")
  companyName        String
  contactEmail       String
  bookingsEmail      String?
  phone              String?

  website            String?
  facebook           String?
  instagram          String?
  tiktok             String?

  timezone           String   @default("America/Mexico_City")
  currency           String   @default("MXN")

  gtmId              String?
  metaPixelId        String?
  ga4Id              String?

  /// A dónde se manda al cliente después de pagar.
  confirmationUrl    String?
  cancellationPolicy String?  @db.Text
  termsUrl           String?
  privacyUrl         String?

  updatedBy          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("company_settings")
}
